# 本机开发配置示例
#
# 用法：
#   cp application-local.yml.example application-local.yml
#   然后填入真实的数据库密码、JWT 密钥、AI API Key
#
# application-local.yml 已加入 .gitignore，不会被提交。
# 该 profile 默认激活（见 application.yml 的 spring.profiles.active）。

spring:
  datasource:
    url: jdbc:mysql://127.0.0.1:3306/diary_platform?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
    username: root
    password: "填你的 MySQL 密码"
  data:
    redis:
      host: 127.0.0.1
      port: 6379
      password:
      database: 0

daytrace:
  jwt:
    # 用 `openssl rand -base64 48` 生成，至少 32 字节
    secret: "填一个至少 32 字节的随机串"
  ai:
    provider: deepseek
    base-url: https://api.deepseek.com
    api-key: "sk-填你的 DeepSeek API Key"
    model: deepseek-chat
    timeout-seconds: 30
    daily-quota: 20

logging:
  level:
    com.daytrace: debug
