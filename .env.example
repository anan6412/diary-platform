# 环境变量模板
#
# 使用方式：
#   1. 复制为 .env（.env 已在 .gitignore 中，不会被提交）
#   2. 填入真实值
#
# 严禁把真实密码 / API Key 写进本文件并提交。

# ---------- 数据库 ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=diary_platform
DB_USERNAME=root
DB_PASSWORD=change_me

# ---------- Redis ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# ---------- JWT ----------
# 至少 32 字节随机串，可用 `openssl rand -base64 48` 生成
JWT_SECRET=change_me_to_a_random_string_at_least_32_bytes
JWT_ACCESS_EXPIRE_MINUTES=120
JWT_REFRESH_EXPIRE_DAYS=7

# ---------- 国产大模型 ----------
# DeepSeek：https://platform.deepseek.com
AI_PROVIDER=deepseek
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=change_me
AI_MODEL=deepseek-chat
AI_TIMEOUT_SECONDS=30
# 单用户每日调用上限
AI_DAILY_QUOTA=20

# ---------- 服务端口 ----------
SERVER_PORT=8080
